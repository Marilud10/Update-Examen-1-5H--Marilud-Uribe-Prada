      "name": "Juntar Todo con Sessions1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\n// Distinguir cada tipo de fila por sus columnas propias:\n// ESTUDIANTES: ID_ESTUDIANTE + NOMBRE + PUNTOS + REGALOS (sin 'materia' ni 'telegram_user')\n// TUTORIAS: id_estudiante + materia + estado (sin 'ID_ESTUDIANTE' en mayusculas)\n// SESSIONS: telegram_user + documento_identidad\nconst filasEstudiantes = items.filter(r => r.ID_ESTUDIANTE !== undefined);\nconst filasTutorias = items.filter(r => r.materia !== undefined);\nconst filasSessions = items.filter(r => r.telegram_user !== undefined);\n\nconst PUNTOS_POR_TUTORIA = 10;\nconst PUNTOS_POR_REGALO = 100;\n\n// 1. Contar tutorÃas Finalizadas por estudiante (recalculo completo, no acumulativo).\nconst conteoFinalizadas = {};\nfilasTutorias.forEach(t => {\n  if ((t.estado || '').toLowerCase() !== 'finalizada') return;\n  const id = String(t.id_estudiante || '').trim();\n  if (!id) return;\n  conteoFinalizadas[id] = (conteoFinalizadas[id] || 0) + 1;\n});\n\n// 2. Mapa de chat_id por documento (desde SESSIONS).\nconst chatIdPorDocumento = {};\nfilasSessions.forEach(s => {\n  const doc = String(s.documento_identidad || '').trim();\n  if (doc) chatIdPorDocumento[doc] = s.telegram_user;\n});\n\n// 3. Recalcular puntos/regalos de cada estudiante y detectar cambios.\nconst cambios = [];\nfilasEstudiantes.forEach(e => {\n  const id = String(e.ID_ESTUDIANTE || '').trim();\n  const finalizadas = conteoFinalizadas[id] || 0;\n  const puntosNuevos = finalizadas * PUNTOS_POR_TUTORIA;\n  const regalosNuevos = Math.floor(puntosNuevos / PUNTOS_POR_REGALO);\n\n  const puntosAnteriores = Number(e.PUNTOS) || 0;\n  const regalosAnteriores = Number(e.REGALOS) || 0;\n\n  if (puntosNuevos === puntosAnteriores && regalosNuevos === regalosAnteriores) {\n    return; // sin cambios, no hace falta actualizar ni notificar\n  }\n\n  cambios.push({\n    id_estudiante: id,\n    nombre: e.NOMBRE,\n    puntos_anteriores: puntosAnteriores,\n    puntos_nuevos: puntosNuevos,\n    regalos_anteriores: regalosAnteriores,\n    regalos_nuevos: regalosNuevos,\n    regalos_ganados_hoy: Math.max(0, regalosNuevos - regalosAnteriores),\n    tutorias_finalizadas: finalizadas,\n    chat_id: chatIdPorDocumento[id] || null\n  });\n});\n\nreturn cambios.map(c => ({ json: c }));"
      },
