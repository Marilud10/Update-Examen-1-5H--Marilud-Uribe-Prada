      "parameters": {
        "jsCode": "const text = $('Recibir Mensaje (Telegram)1').first().json.message?.text || '';\n\nconst nombreMatch = text.match(/Nombre:\\s*(.+?)(?:\\r?\\n|$)/i);\nconst documentoMatch = text.match(/Documento:\\s*(\\d+)/i);\n\nif (nombreMatch && documentoMatch) {\n  return [{\n    json: {\n      ...$json,\n      nombre: nombreMatch[1].trim(),\n      documento: documentoMatch[1].trim(),\n      datosValidos: true\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    nombre: '',\n    documento: '',\n    datosValidos: false,\n    textoDetectado: text\n  }\n}];"
      },
